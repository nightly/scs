digraph finite_state_machine {
	fontname="Helvetica Neue, Helvetica, Arial, sans - serif"
	node [fontname="Helvetica Neue, Helvetica, Arial, sans - serif"]
	edge [fontname="Helvetica Neue, Helvetica, Arial, sans - serif"]
	rankdir=LR;
	forcelabels=true;
	node [shape = doublecircle];
	<0>;
	"0" [xlabel=True]
	node [shape = circle];
	"0" -> "0" [label = <⟨π __scs_pick_5_part,__scs_pick_6_bit,__scs_pick_7_diameter{RadialDrill(var(__scs_pick_5_part), var(__scs_pick_6_bit), var(__scs_pick_7_diameter), obj(3))}, ∃b. equipped_bit(var(b), obj(3))⟩>];
	"0" -> "0" [label = <⟨{AttachBit(obj(3mm), obj(3))}, ¬∃b. equipped_bit(var(b), obj(3))⟩>];
	"0" -> "0" [label = <⟨{AttachBit(obj(5mm), obj(3))}, ¬∃b. equipped_bit(var(b), obj(3))⟩>];
	"0" -> "0" [label = <⟨π __scs_pick_4_part{In(var(__scs_pick_4_part), obj(3))}, True⟩>];
	"0" -> "0" [label = <⟨π __scs_pick_3_part{Out(var(__scs_pick_3_part), obj(3))}, True⟩>];
	"0" -> "0" [label = <⟨π __scs_pick_1_part1,__scs_pick_2_part2{ApplyAdhesive(var(__scs_pick_1_part1), var(__scs_pick_2_part2), obj(3))}, True⟩>];
	"0" -> "0" [label = <⟨{Nop()}, True⟩>];
	"0" -> "0" [label = <⟨π __scs_pick_0_bit{DetachBit(var(__scs_pick_0_bit), obj(3))}, True⟩>];
}
